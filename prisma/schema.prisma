datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../lib/generated/prisma"
}

// ------------------------------------------------------
// User & Authentication (NextAuth)
// ------------------------------------------------------
model User {
  id              String               @id @default(cuid())
  name            String?
  email           String?              @unique
  emailVerified   DateTime?
  image           String?
  password        String? // null for an SSO-only account once a provider using the Account/Session models below is added
  role            Role                 @default(CONTRIBUTOR)
  slug            String?              @unique
  bio             String?              @db.Text
  socialLinks     String?              @db.Text // JSON string for social links
  accounts        Account[]
  sessions        Session[]
  adminSessions   AdminSession[]
  posts           Post[]
  pages           Page[]
  caseStudies     CaseStudy[]
  approvalHistory ApprovalHistory[]
  pipelineRuns    ContentPipelineRun[]

  // TOTP two-factor auth. twoFactorSecret is written as soon as setup
  // begins but twoFactorEnabled stays false until the user proves they can
  // generate a valid code with it (lib/auth.ts's confirmTwoFactorSetup) —
  // an abandoned setup attempt never silently enables 2FA.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  twoFactorBackupCodes String? @db.Text // JSON array of bcrypt-hashed one-time codes

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Fixed, backend-enforced role set — see lib/permissions.ts for what each
// role can do. Not a dynamic/admin-editable permission system by design.
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SEO_MANAGER
  CONTRIBUTOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A device/session-list entry for the admin UI — distinct from the Session
// model above (which belongs to NextAuth's adapter, unused while this app
// is Credentials+JWT-only, and reserved for a future SSO provider's account
// linking). This app stays JWT-based even with this table: the JWT carries
// this row's id as `sessionId`, and lib/auth-guard.ts's requireSession()
// checks `revokedAt` on every request — the one DB round-trip that makes
// "revoke this device" actually take effect without switching to NextAuth's
// database session strategy (which CredentialsProvider can't use in v4).
model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ------------------------------------------------------
// CMS Content Models
// ------------------------------------------------------

model Page {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  content String? @db.Text

  // Relations
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  // Approval assignment — reviewer/seoReviewer/approver are plain user-id
  // pointers (no Prisma relation/FK), same lightweight-reference pattern as
  // ApprovalHistory.contentId, so assigning one more role doesn't need a new
  // back-relation array on User each time. Resolved to a name via a manual
  // lookup where displayed, not Prisma's `include`.
  reviewerId     String?
  seoReviewerId  String?
  approverId     String?
  reviewDeadline DateTime?

  // SEO Fields
  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String? @db.Text // JSON string[] — see lib/seo-fields.ts
  ogImage           String?
  twitterCard       String?
  canonicalUrl      String?
  schemaJson        String? @db.Text
  isIndexable       Boolean @default(true)
  allowFollow       Boolean @default(true) // the other half of the robots directive — see buildRobotsMeta() in lib/seo-meta.ts
  maxSnippet        Int     @default(-1) // Google robots meta max-snippet: -1 unlimited, 0 none, or a max character count
  maxImagePreview   String  @default("large") // "none" | "standard" | "large"
  maxVideoPreview   Int     @default(-1) // -1 unlimited, 0 none, or a max number of seconds

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage, then to SiteSetting.defaultOgImage, when empty.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  // Settings
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Post {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  content          String  @db.Text
  excerpt          String? @db.Text
  featuredImage    String?
  featuredImageAlt String?

  // Relations
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  categories Category[]
  tags       Tag[]

  // Approval assignment — see the matching comment on Page for why these
  // are plain id pointers rather than Prisma relations.
  reviewerId     String?
  seoReviewerId  String?
  approverId     String?
  reviewDeadline DateTime?

  // SEO Fields
  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String? @db.Text // JSON string[] — see lib/seo-fields.ts
  ogImage           String?
  twitterCard       String?
  canonicalUrl      String?
  schemaJson        String? @db.Text
  seoScore          Int?
  readabilityScore  Int?
  keywordDensity    Float?
  isIndexable       Boolean @default(true)
  allowFollow       Boolean @default(true) // the other half of the robots directive — see buildRobotsMeta() in lib/seo-meta.ts
  maxSnippet        Int     @default(-1) // Google robots meta max-snippet: -1 unlimited, 0 none, or a max character count
  maxImagePreview   String  @default("large") // "none" | "standard" | "large"
  maxVideoPreview   Int     @default(-1) // -1 unlimited, 0 none, or a max number of seconds

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage/featuredImage, then SiteSetting.defaultOgImage.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  // Settings
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       Post[]
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id])
  caseStudyId String?
}

model Tag {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  posts       Post[]
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id])
  caseStudyId String?
}

// Content workflow: DRAFT -> REVIEW -> (CHANGES_REQUESTED -> REVIEW)* -> APPROVED
// -> SCHEDULED|PUBLISHED -> ARCHIVED. See lib/workflow.ts for the transition
// graph and which permission each move requires.
enum PostStatus {
  DRAFT
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  POST
  PAGE
  CASE_STUDY
}

model ApprovalHistory {
  id          String      @id @default(cuid())
  contentType ContentType
  contentId   String
  fromStatus  PostStatus?
  toStatus    PostStatus
  action      String // submit | approve | requestChanges | reject | resubmit | schedule | publish | unpublish | archive | restore
  comment     String?     @db.Text
  actorId     String
  actor       User        @relation(fields: [actorId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([contentType, contentId])
}

enum PipelineStage {
  BRIEF
  SEARCH_INTENT
  RESEARCH
  OUTLINE
  DRAFT
  IMAGE
  SEO
  INTERNAL_LINKS
  SCHEMA
  QA
  APPROVAL
  PUBLISHED
  // Not part of ContentPipelineRun's state machine (PIPELINE_STAGE_ORDER in
  // lib/content-pipeline/types.ts) at all — used only to tag AiJob rows
  // created for a ContentRefresh cycle, so the Job Queue/Cost Dashboard
  // can show and price those jobs the same way as every other AI call.
  REFRESH
}

// Tracks one run of the AI content pipeline (Brief -> Search Intent ->
// Research -> Outline -> Draft -> SEO -> Internal Links -> Schema -> QA ->
// Human Approval -> Publish) for a single piece of content. `stage` is the
// last stage completed; the admin UI always offers to run whichever stage
// comes next (lib/content-pipeline/types.ts's PIPELINE_STAGE_ORDER).
//
// contentType/contentId point at the real Post/CaseStudy row created once
// the Draft stage runs via the normal createPost/createCaseStudy actions —
// before that, this row is the only record of the run (brief/searchIntent/
// research/outline live here as JSON, same "serialize as String @db.Text"
// convention as every other JSON-shaped column in this schema, e.g.
// ScheduledJob.payload). After Draft, this row stops duplicating fields
// that now live on the real content row (content, metaTitle, schemaJson,
// ...) and only keeps the pipeline's own bookkeeping.
model ContentPipelineRun {
  id          String      @id @default(cuid())
  contentType ContentType // POST | CASE_STUDY — PAGE unused by this feature
  contentId   String?

  stage PipelineStage @default(BRIEF)

  brief          String  @db.Text // JSON: topic/goal/audience/tone/notes/(case study fields)
  searchIntent   String? @db.Text // JSON
  research       String? @db.Text // JSON
  outline        String? @db.Text // JSON
  internalLinks  String? @db.Text // JSON: links actually applied to the draft
  schemaNotes    String? @db.Text // JSON: schema.org type chosen + notes
  qaReport       String? @db.Text // JSON
  // JSON: GeneratedImage (lib/content-pipeline/types.ts) — the latest
  // AI-generated featured image pending human review. Overwritten on each
  // "Regenerate" (the prior MediaAsset row is left in the library, not
  // deleted — same append-only-in-spirit approach as everything else in
  // this schema). `approved` flips true only once attachGeneratedImage()
  // has actually written featuredImage/featuredImageAlt onto the real
  // content row — approval and attachment are the same action, not two.
  generatedImage String? @db.Text

  approvedAt   DateTime?
  approvedById String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs AiJob[]

  @@index([contentType, contentId])
  @@index([createdById])
}

enum AiJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// One tracked AI-provider call per (pipeline run, stage) — not a generic
// task queue. `idempotencyKey` ("<pipelineRunId>:<stage>") is the actual
// idempotency guarantee: starting a job looks this up first, and a stage
// that's already COMPLETED is never re-run (see
// lib/content-pipeline/jobs.ts's startOrResumeJob) — calling the same
// stage-advance action twice, whether a genuine double-click or a retried
// request, can only execute the underlying Claude call and its side
// effects once. A FAILED job's retry reuses this same row (same Job ID),
// incrementing retryCount, rather than creating a new one.
//
// Jobs run synchronously inside the request that triggers them (the
// pipeline wizard calls each stage inline, deliberately, to stay inside
// one Cloudflare Workers request — see docs/runbooks/ai-content-pipeline.md)
// — QUEUED/PROCESSING/COMPLETED/FAILED are still real, meaningful states
// (a QUEUED/PROCESSING row with no completedAt after a request clearly
// died mid-flight is itself diagnostic), just not asynchronously processed
// by a separate worker.
model AiJob {
  id               String              @id @default(cuid())
  idempotencyKey   String              @unique
  // Exactly one of pipelineRunId/contentRefreshId is set — a job always
  // belongs to either a ContentPipelineRun or a ContentRefresh cycle,
  // never both and never neither. Optional (not a discriminated union)
  // because Prisma has no native way to express "exactly one of two FKs,"
  // same pragmatic tradeoff as elsewhere in this schema.
  pipelineRunId    String?
  pipelineRun      ContentPipelineRun? @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  contentRefreshId String?
  contentRefresh   ContentRefresh?     @relation(fields: [contentRefreshId], references: [id], onDelete: Cascade)
  contentId        String? // the real Post/CaseStudy id, once known (unset for pre-Draft stages)
  stage            PipelineStage
  provider         String // "anthropic"
  model            String // actual model id used, e.g. "claude-sonnet-5-5"
  status           AiJobStatus         @default(QUEUED)
  error            String?             @db.Text
  retryCount       Int                 @default(0)

  // Cost tracking — set on both COMPLETED and FAILED when the provider
  // actually returned a response (so a call that failed only because the
  // reply wasn't valid JSON still records what it cost; a call that never
  // got a response, e.g. a network/auth error, has none of these set,
  // since nothing was billed). costUsd is null whenever `model` isn't in
  // lib/content-pipeline/pricing.ts's rate table — never a silently wrong
  // number — and the cost dashboard calls that out explicitly rather than
  // undercounting without saying so.
  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?
  costUsd      Float?

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([pipelineRunId])
  @@index([contentRefreshId])
  @@index([status])
  @@index([contentId])
}

enum ContentRefreshStatus {
  DETECTED // flagged by a scan; no AI call has run yet
  DRAFTING // an AI draft call is in flight
  DRAFTED // a proposed revision exists, pending human approval
  APPROVED // a human signed off; not yet applied
  REJECTED // a human discarded this draft — a later scan can start a new cycle
  APPLIED // the approved draft has been written onto the live content row
}

// One refresh cycle for one EXISTING, already-published piece of content —
// never a new piece of content, and the live Post/CaseStudy row is never
// touched until applyRefreshDraft() runs, after human approval. Detection
// (lib/content-refresh/detect.ts) only ever creates/updates rows here; it
// never writes to Post/CaseStudy. `draftContent`/the other draft* fields
// are the proposed revision, staged — the same "look, never touch
// published content automatically" principle as the AI Content Pipeline's
// own mandatory Human Approval step, just for an edit to existing content
// instead of a brand-new piece.
model ContentRefresh {
  id          String      @id @default(cuid())
  contentType ContentType // POST | CASE_STUDY
  contentId   String

  // JSON: DetectedSignal[] (lib/content-refresh/types.ts) — what triggered
  // this cycle (old content, outdated mentions, ranking/traffic/CTR decline).
  signals String               @db.Text
  status  ContentRefreshStatus @default(DETECTED)

  draftTitle           String?
  draftContent         String? @db.Text
  draftExcerpt         String? @db.Text
  draftMetaTitle       String?
  draftMetaDescription String? @db.Text
  changeSummary        String? @db.Text // the AI's own explanation of what it changed and why

  createdById  String? // null when a scheduled scan (no human session) created this row, rather than an admin's own "Scan Now" click
  approvedById String?
  approvedAt   DateTime?
  appliedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs AiJob[]

  @@index([contentType, contentId])
  @@index([status])
}

enum PromptCategory {
  BLOG
  CASE_STUDY
  SERVICE
  LANDING_PAGE
  SEO
  SOCIAL
  IMAGE
  REFRESH
}

// One editable, versioned prompt per category — the admin-facing Prompt
// Library at /admin/ai-pipeline/prompts. Only BLOG, CASE_STUDY, and SEO
// are actually read by a live pipeline stage today (lib/content-pipeline/
// prompt-library.ts's WIRED_CATEGORIES) — the other five exist so an
// editor can author/version their prompt ahead of the generation feature
// that will eventually consume it, same as drafting copy for a page that
// hasn't shipped yet.
//
// activeVersionId is which version prompt-library.ts actually serves to
// the pipeline right now. Every edit creates a new, immutable
// PromptTemplateVersion row (append-only, same convention as
// ContentVersion below) instead of overwriting one — "Rollback" is just
// repointing activeVersionId at an older version, never deleting anything.
//
// createdById/updatedById are plain user-id pointers (no Prisma relation),
// same lightweight pattern Page/Post/CaseStudy already use for
// reviewerId/seoReviewerId/approverId, resolved via a manual lookup where
// displayed rather than growing User with more back-relation arrays.
model PromptTemplate {
  id          String         @id @default(cuid())
  category    PromptCategory @unique
  name        String
  description String?        @db.Text

  activeVersionId String?                 @unique
  activeVersion   PromptTemplateVersion?  @relation("ActivePromptVersion", fields: [activeVersionId], references: [id])
  versions        PromptTemplateVersion[] @relation("PromptVersions")

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromptTemplateVersion {
  id            String          @id @default(cuid())
  templateId    String
  template      PromptTemplate  @relation("PromptVersions", fields: [templateId], references: [id], onDelete: Cascade)
  activeFor     PromptTemplate? @relation("ActivePromptVersion")
  versionNumber Int

  // Overrides the stage's default persona/system text when set; null means
  // "use the pipeline's own hardcoded default" (see resolvePrompt()).
  systemPrompt String? @db.Text
  // The admin-editable instructional/style text — supports {{placeholder}}
  // substitution (see fillTemplate()). Never the whole prompt: the pipeline
  // always appends its own code-generated dynamic context (brief/outline/
  // keyword) before this and its own JSON-output contract after it, so an
  // edit here can't accidentally break the parser that reads the model's
  // reply.
  bodyTemplate String  @db.Text
  changeNote   String? @db.Text

  createdById String
  createdAt   DateTime @default(now())

  @@unique([templateId, versionNumber])
  @@index([templateId])
}

enum BrandSectionKey {
  BRAND_VOICE
  AUDIENCE
  SERVICES
  PRODUCTS
  USPS
  TERMINOLOGY
  FORBIDDEN_TERMS
  CTA_RULES
  EXAMPLES
  GUIDELINES
}

// The central Brand Knowledge Base at /admin/brand-kb — one versioned
// section per BrandSectionKey, same append-only version/active-version/
// rollback shape as PromptTemplate above (duplicated rather than shared,
// since the two hold genuinely different content and this project's own
// convention is "three similar lines beat a premature abstraction").
//
// lib/brand-kb/context.ts's buildBrandContextBlock() assembles every
// section with content into one block and injects it into EVERY AI
// pipeline stage's system prompt (lib/content-pipeline/prompts.ts) — not
// just the stage-specific Prompt Library categories — since brand voice/
// audience/forbidden terms/terminology apply to everything the pipeline
// generates, not one content type. FORBIDDEN_TERMS also gets a real,
// code-computed check in the QA stage (lib/content-pipeline/stages.ts),
// not just a model instruction — the model is asked to avoid them, and
// the output is actually checked for them.
model BrandKnowledgeSection {
  id  String          @id @default(cuid())
  key BrandSectionKey @unique

  activeVersionId String?                 @unique
  activeVersion   BrandKnowledgeVersion?  @relation("ActiveBrandVersion", fields: [activeVersionId], references: [id])
  versions        BrandKnowledgeVersion[] @relation("BrandVersions")

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandKnowledgeVersion {
  id            String                 @id @default(cuid())
  sectionId     String
  section       BrandKnowledgeSection  @relation("BrandVersions", fields: [sectionId], references: [id], onDelete: Cascade)
  activeFor     BrandKnowledgeSection? @relation("ActiveBrandVersion")
  versionNumber Int

  content    String  @db.Text
  changeNote String? @db.Text

  createdById String
  createdAt   DateTime @default(now())

  @@unique([sectionId, versionNumber])
  @@index([sectionId])
}

// Full-content snapshots for history/compare/restore — separate from
// ApprovalHistory (workflow status transitions) and AuditLog (lean
// system-wide mutation metadata). This is the only one of the three that
// stores the complete editable content, since it's the only one that needs
// to actually reconstruct a past version.
//
// Append-only: restoring an old version never deletes or overwrites any row
// here. It applies that version's snapshot to the live record and then
// writes a BRAND NEW version on top (see lib/versioning.ts), so the full
// linear history — including every restore — is always preserved.
model ContentVersion {
  id            String      @id @default(cuid())
  contentType   ContentType
  contentId     String
  versionNumber Int
  snapshot      String      @db.Text // JSON of the content's editable fields at this point — never status/workflow fields, those belong to ApprovalHistory
  changeSummary String?     @db.Text
  authorId      String?
  authorName    String?
  authorEmail   String?
  createdAt     DateTime    @default(now())

  @@unique([contentType, contentId, versionNumber])
  @@index([contentType, contentId])
}

// Central media library — parallel to, not a foreign key from, the scattered
// String URL fields on Post/CaseStudy/etc. Picking or uploading an asset here
// just hands back a URL to use, same as pasting one today; this table exists
// so uploads can be searched/browsed/replaced/deleted from one place with
// enforced alt text, not to replace those existing fields.
model MediaAsset {
  id       String @id @default(cuid())
  publicId String @unique // Cloudinary public_id — needed for destroy/replace
  url      String // secure_url, canonical, untransformed — f_auto/q_auto applied at render time via lib/cloudinary-url.ts
  filename String
  format   String
  width    Int
  height   Int
  bytes    Int
  folder   String // logical category, decoupled from Cloudinary's real storage path
  altText  String // required — enforced before upload even reaches Cloudinary
  title    String // defaults to filename if not supplied

  uploadedById    String?
  uploadedByName  String?
  uploadedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
}

enum TranslationStatus {
  DRAFT
  PUBLISHED
}

// Multi-language / i18n architecture — one row per (content item, locale).
// contentType is a plain string, not the workflow ContentType enum, for the
// same reason ContentLock's is: it must also cover SERVICE, and here also
// the taxonomy tables (CATEGORY/TAG). A translation is an OVERLAY, not a
// duplicate record — every field here is nullable and only overrides the
// base row's matching field when present; images, order, booleans, and
// workflow status always come from the base record. locale is never
// "en-GB" (the default/unprefixed locale IS the base record, no overlay
// needed); see lib/i18n.ts for the closed locale set and lib/translation.ts
// for how an overlay is resolved against its base record at render time.
model ContentTranslation {
  id          String @id @default(cuid())
  contentType String
  contentId   String
  locale      String

  slug        String? // localized URL slug override; null = reuse the base record's slug
  title       String?
  subtitle    String? // Service only
  excerpt     String? @db.Text
  content     String? @db.Text
  detailTitle String? // Service only
  detailIntro String? @db.Text // Service only

  metaTitle          String?
  metaDescription    String?
  focusKeyword       String?
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text

  status TranslationStatus @default(DRAFT)

  translatedById    String?
  translatedByName  String?
  translatedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentType, contentId, locale])
  @@unique([contentType, locale, slug]) // Postgres treats multiple NULLs as distinct, so untranslated rows never collide here
  @@index([locale])
}

enum ScheduledJobType {
  PUBLISH
  UNPUBLISH
  UPDATE
}

enum ScheduledJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// A pending future action on a piece of content — publish at a given instant,
// unpublish at a given instant, or apply a staged content edit at a given
// instant. One row per scheduled action; re-scheduling cancels the old
// pending row for that (contentType, contentId, jobType) rather than leaving
// two competing schedules.
//
// `runAt` is always an absolute UTC instant (computed from the admin's
// chosen date/time/timezone at creation time via lib/scheduling.ts).
// `timezone` is kept only so the UI can display back what the admin
// originally picked — it plays no role in execution once `runAt` exists.
//
// Retry-safe by construction: the cron processor (app/api/cron/scheduled-jobs)
// atomically claims a PENDING row (PENDING -> PROCESSING, conditioned on
// still being PENDING) before acting on it, so two overlapping cron runs
// can't double-publish the same job. A failed attempt reverts the row to
// PENDING (so the next tick retries it) until `attempts` hits the cap, at
// which point it's marked FAILED and left for manual attention — never
// silently dropped.
model ScheduledJob {
  id          String             @id @default(cuid())
  contentType ContentType
  contentId   String
  jobType     ScheduledJobType
  runAt       DateTime
  timezone    String
  status      ScheduledJobStatus @default(PENDING)
  payload     String?            @db.Text // JSON snapshot of new field values, UPDATE jobs only

  attempts      Int       @default(0)
  lastError     String?   @db.Text
  lastAttemptAt DateTime?

  createdById    String?
  createdByName  String?
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([contentType, contentId])
}

// System-wide, append-only mutation log — separate from ApprovalHistory,
// which is purpose-built for the content workflow timeline UI. This covers
// every admin mutation (content, SEO, settings, users, roles, publishing,
// approval, media, redirects, integrations), not just content status.
//
// User fields are a denormalized snapshot (name/email/role at the time of
// the action), not a Prisma relation to User — an audit entry must survive
// the acting user being deleted later, and must keep showing the role they
// held *then* even if their role changes afterward. userId is kept as a
// plain reference for filtering, same lightweight-reference pattern used
// elsewhere in this schema (e.g. ApprovalHistory.contentId).
//
// No update path exists anywhere in the app for this model — entries are
// immutable once written. Deletion is restricted to SUPER_ADMIN only (see
// lib/auth-guard.ts / app/(admin)/actions/audit.ts); ADMIN and below can
// read but never alter or remove entries.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userEmail   String?
  userRole    Role?
  action      String // create | update | delete | publish | approve | login | etc — free-form, always past-tense-free verb
  category    String // Content | SEO | Settings | Users | Roles | Publishing | Approval | Media | Redirects | Integrations
  entityType  String // "Post", "Page", "User", "Redirect", "SiteSetting", ...
  entityId    String?
  entityLabel String? // human-readable label (title/name/email) snapshotted at write time, for a readable log without extra joins
  before      String?  @db.Text // JSON snapshot, null on create
  after       String?  @db.Text // JSON snapshot, null on delete
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model CaseStudy {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  clientName       String
  industry         String
  serviceType      String
  results          String?  @db.Text
  content          String   @db.Text
  excerpt          String?  @db.Text
  websiteUrl       String?
  featuredImage    String?
  featuredImageAlt String?
  imageGallery     String[] // Array of image URLs
  isFeatured       Boolean  @default(false) // Show on home page

  // Relations
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  categories Category[]
  tags       Tag[]

  // Approval assignment — see the matching comment on Page for why these
  // are plain id pointers rather than Prisma relations.
  reviewerId     String?
  seoReviewerId  String?
  approverId     String?
  reviewDeadline DateTime?

  // SEO Fields
  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  secondaryKeywords String? @db.Text // JSON string[] — see lib/seo-fields.ts
  ogImage           String?
  twitterCard       String?
  canonicalUrl      String?
  schemaJson        String? @db.Text
  seoScore          Int?
  readabilityScore  Int?
  keywordDensity    Float?
  isIndexable       Boolean @default(true)
  allowFollow       Boolean @default(true) // the other half of the robots directive — see buildRobotsMeta() in lib/seo-meta.ts
  maxSnippet        Int     @default(-1) // Google robots meta max-snippet: -1 unlimited, 0 none, or a max character count
  maxImagePreview   String  @default("large") // "none" | "standard" | "large"
  maxVideoPreview   Int     @default(-1) // -1 unlimited, 0 none, or a max number of seconds

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage/featuredImage, then SiteSetting.defaultOgImage.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  // Settings
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

