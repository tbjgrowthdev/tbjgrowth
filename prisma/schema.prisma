datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../lib/generated/prisma"
}

// ------------------------------------------------------
// User & Authentication (NextAuth)
// ------------------------------------------------------
model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  image           String?
  password        String? // null for an SSO-only account once a provider using the Account/Session models below is added
  role            Role              @default(CONTRIBUTOR)
  slug            String?           @unique
  bio             String?           @db.Text
  socialLinks     String?           @db.Text // JSON string for social links
  accounts        Account[]
  sessions        Session[]
  adminSessions   AdminSession[]
  posts           Post[]
  pages           Page[]
  caseStudies     CaseStudy[]
  approvalHistory ApprovalHistory[]

  // TOTP two-factor auth. twoFactorSecret is written as soon as setup
  // begins but twoFactorEnabled stays false until the user proves they can
  // generate a valid code with it (lib/auth.ts's confirmTwoFactorSetup) —
  // an abandoned setup attempt never silently enables 2FA.
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  twoFactorBackupCodes String? @db.Text // JSON array of bcrypt-hashed one-time codes

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// Fixed, backend-enforced role set — see lib/permissions.ts for what each
// role can do. Not a dynamic/admin-editable permission system by design.
enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SEO_MANAGER
  CONTRIBUTOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A device/session-list entry for the admin UI — distinct from the Session
// model above (which belongs to NextAuth's adapter, unused while this app
// is Credentials+JWT-only, and reserved for a future SSO provider's account
// linking). This app stays JWT-based even with this table: the JWT carries
// this row's id as `sessionId`, and lib/auth-guard.ts's requireSession()
// checks `revokedAt` on every request — the one DB round-trip that makes
// "revoke this device" actually take effect without switching to NextAuth's
// database session strategy (which CredentialsProvider can't use in v4).
model AdminSession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
}

// ------------------------------------------------------
// CMS Content Models
// ------------------------------------------------------

model Page {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  content String? @db.Text

  // Relations
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])

  // Approval assignment — reviewer/seoReviewer/approver are plain user-id
  // pointers (no Prisma relation/FK), same lightweight-reference pattern as
  // ApprovalHistory.contentId, so assigning one more role doesn't need a new
  // back-relation array on User each time. Resolved to a name via a manual
  // lookup where displayed, not Prisma's `include`.
  reviewerId     String?
  seoReviewerId  String?
  approverId     String?
  reviewDeadline DateTime?

  // SEO Fields
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  ogImage         String?
  twitterCard     String?
  canonicalUrl    String?
  schemaJson      String? @db.Text
  isIndexable     Boolean @default(true)

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage, then to SiteSetting.defaultOgImage, when empty.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  // Settings
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Post {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  content          String  @db.Text
  excerpt          String? @db.Text
  featuredImage    String?
  featuredImageAlt String?

  // Relations
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  categories Category[]
  tags       Tag[]

  // Approval assignment — see the matching comment on Page for why these
  // are plain id pointers rather than Prisma relations.
  reviewerId     String?
  seoReviewerId  String?
  approverId     String?
  reviewDeadline DateTime?

  // SEO Fields
  metaTitle        String?
  metaDescription  String?
  focusKeyword     String?
  ogImage          String?
  twitterCard      String?
  canonicalUrl     String?
  schemaJson       String? @db.Text
  seoScore         Int?
  readabilityScore Int?
  keywordDensity   Float?
  isIndexable      Boolean @default(true)

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage/featuredImage, then SiteSetting.defaultOgImage.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  // Settings
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       Post[]
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id])
  caseStudyId String?
}

model Tag {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  posts       Post[]
  caseStudy   CaseStudy? @relation(fields: [caseStudyId], references: [id])
  caseStudyId String?
}

// Content workflow: DRAFT -> REVIEW -> (CHANGES_REQUESTED -> REVIEW)* -> APPROVED
// -> SCHEDULED|PUBLISHED -> ARCHIVED. See lib/workflow.ts for the transition
// graph and which permission each move requires.
enum PostStatus {
  DRAFT
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ContentType {
  POST
  PAGE
  CASE_STUDY
}

model ApprovalHistory {
  id          String      @id @default(cuid())
  contentType ContentType
  contentId   String
  fromStatus  PostStatus?
  toStatus    PostStatus
  action      String // submit | approve | requestChanges | reject | resubmit | schedule | publish | unpublish | archive | restore
  comment     String?     @db.Text
  actorId     String
  actor       User        @relation(fields: [actorId], references: [id])
  createdAt   DateTime    @default(now())

  @@index([contentType, contentId])
}

enum BrandSectionKey {
  BRAND_VOICE
  AUDIENCE
  SERVICES
  PRODUCTS
  USPS
  TERMINOLOGY
  FORBIDDEN_TERMS
  CTA_RULES
  EXAMPLES
  GUIDELINES
}

// The central Brand Knowledge Base at /admin/brand-kb — one versioned
// section per BrandSectionKey, with an append-only version history and an
// activeVersionId pointer for rollback (activating an older version is
// never a delete, just repointing which one is live).
//
// lib/brand-kb/context.ts's buildBrandContextBlock() assembles every
// section with content into one block and injects it into EVERY AI
// pipeline stage's system prompt (lib/content-pipeline/prompts.ts) — not
// just the stage-specific Prompt Library categories — since brand voice/
// audience/forbidden terms/terminology apply to everything the pipeline
// generates, not one content type. FORBIDDEN_TERMS also gets a real,
// code-computed check in the QA stage (lib/content-pipeline/stages.ts),
// not just a model instruction — the model is asked to avoid them, and
// the output is actually checked for them.
model BrandKnowledgeSection {
  id  String          @id @default(cuid())
  key BrandSectionKey @unique

  activeVersionId String?                 @unique
  activeVersion   BrandKnowledgeVersion?  @relation("ActiveBrandVersion", fields: [activeVersionId], references: [id])
  versions        BrandKnowledgeVersion[] @relation("BrandVersions")

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrandKnowledgeVersion {
  id            String                 @id @default(cuid())
  sectionId     String
  section       BrandKnowledgeSection  @relation("BrandVersions", fields: [sectionId], references: [id], onDelete: Cascade)
  activeFor     BrandKnowledgeSection? @relation("ActiveBrandVersion")
  versionNumber Int

  content    String  @db.Text
  changeNote String? @db.Text

  createdById String
  createdAt   DateTime @default(now())

  @@unique([sectionId, versionNumber])
  @@index([sectionId])
}

// Full-content snapshots for history/compare/restore — separate from
// ApprovalHistory (workflow status transitions) and AuditLog (lean
// system-wide mutation metadata). This is the only one of the three that
// stores the complete editable content, since it's the only one that needs
// to actually reconstruct a past version.
//
// Append-only: restoring an old version never deletes or overwrites any row
// here. It applies that version's snapshot to the live record and then
// writes a BRAND NEW version on top (see lib/versioning.ts), so the full
// linear history — including every restore — is always preserved.
model ContentVersion {
  id            String      @id @default(cuid())
  contentType   ContentType
  contentId     String
  versionNumber Int
  snapshot      String      @db.Text // JSON of the content's editable fields at this point — never status/workflow fields, those belong to ApprovalHistory
  changeSummary String?     @db.Text
  authorId      String?
  authorName    String?
  authorEmail   String?
  createdAt     DateTime    @default(now())

  @@unique([contentType, contentId, versionNumber])
  @@index([contentType, contentId])
}

// Central media library — parallel to, not a foreign key from, the scattered
// String URL fields on Post/CaseStudy/etc. Picking or uploading an asset here
// just hands back a URL to use, same as pasting one today; this table exists
// so uploads can be searched/browsed/replaced/deleted from one place with
// enforced alt text, not to replace those existing fields.
model MediaAsset {
  id       String @id @default(cuid())
  publicId String @unique // Cloudinary public_id — needed for destroy/replace
  url      String // secure_url, canonical, untransformed — f_auto/q_auto applied at render time via lib/cloudinary-url.ts
  filename String
  format   String
  width    Int
  height   Int
  bytes    Int
  folder   String // logical category, decoupled from Cloudinary's real storage path
  altText  String // required — enforced before upload even reaches Cloudinary
  title    String // defaults to filename if not supplied

  uploadedById    String?
  uploadedByName  String?
  uploadedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
}

enum TranslationStatus {
  DRAFT
  PUBLISHED
}

// Multi-language / i18n architecture — one row per (content item, locale).
// contentType is a plain string, not the workflow ContentType enum, for the
// same reason ContentLock's is: it must also cover SERVICE, and here also
// the taxonomy tables (CATEGORY/TAG). A translation is an OVERLAY, not a
// duplicate record — every field here is nullable and only overrides the
// base row's matching field when present; images, order, booleans, and
// workflow status always come from the base record. locale is never
// "en-GB" (the default/unprefixed locale IS the base record, no overlay
// needed); see lib/i18n.ts for the closed locale set and lib/translation.ts
// for how an overlay is resolved against its base record at render time.
model ContentTranslation {
  id          String @id @default(cuid())
  contentType String
  contentId   String
  locale      String

  slug        String? // localized URL slug override; null = reuse the base record's slug
  title       String?
  subtitle    String? // Service only
  excerpt     String? @db.Text
  content     String? @db.Text
  detailTitle String? // Service only
  detailIntro String? @db.Text // Service only

  metaTitle          String?
  metaDescription    String?
  focusKeyword       String?
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text

  status TranslationStatus @default(DRAFT)

  translatedById    String?
  translatedByName  String?
  translatedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentType, contentId, locale])
  @@unique([contentType, locale, slug]) // Postgres treats multiple NULLs as distinct, so untranslated rows never collide here
  @@index([locale])
}

enum ScheduledJobType {
  PUBLISH
  UNPUBLISH
  UPDATE
}

enum ScheduledJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// A pending future action on a piece of content — publish at a given instant,
// unpublish at a given instant, or apply a staged content edit at a given
// instant. One row per scheduled action; re-scheduling cancels the old
// pending row for that (contentType, contentId, jobType) rather than leaving
// two competing schedules.
//
// `runAt` is always an absolute UTC instant (computed from the admin's
// chosen date/time/timezone at creation time via lib/scheduling.ts).
// `timezone` is kept only so the UI can display back what the admin
// originally picked — it plays no role in execution once `runAt` exists.
//
// Retry-safe by construction: the cron processor (app/api/cron/scheduled-jobs)
// atomically claims a PENDING row (PENDING -> PROCESSING, conditioned on
// still being PENDING) before acting on it, so two overlapping cron runs
// can't double-publish the same job. A failed attempt reverts the row to
// PENDING (so the next tick retries it) until `attempts` hits the cap, at
// which point it's marked FAILED and left for manual attention — never
// silently dropped.
model ScheduledJob {
  id          String             @id @default(cuid())
  contentType ContentType
  contentId   String
  jobType     ScheduledJobType
  runAt       DateTime
  timezone    String
  status      ScheduledJobStatus @default(PENDING)
  payload     String?            @db.Text // JSON snapshot of new field values, UPDATE jobs only

  attempts      Int       @default(0)
  lastError     String?   @db.Text
  lastAttemptAt DateTime?

  createdById    String?
  createdByName  String?
  createdByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@index([contentType, contentId])
}

// System-wide, append-only mutation log — separate from ApprovalHistory,
// which is purpose-built for the content workflow timeline UI. This covers
// every admin mutation (content, SEO, settings, users, roles, publishing,
// approval, media, redirects, integrations), not just content status.
//
// User fields are a denormalized snapshot (name/email/role at the time of
// the action), not a Prisma relation to User — an audit entry must survive
// the acting user being deleted later, and must keep showing the role they
// held *then* even if their role changes afterward. userId is kept as a
// plain reference for filtering, same lightweight-reference pattern used
// elsewhere in this schema (e.g. ApprovalHistory.contentId).
//
// No update path exists anywhere in the app for this model — entries are
// immutable once written. Deletion is restricted to SUPER_ADMIN only (see
// lib/auth-guard.ts / app/(admin)/actions/audit.ts); ADMIN and below can
// read but never alter or remove entries.
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  userEmail   String?
  userRole    Role?
  action      String // create | update | delete | publish | approve | login | etc — free-form, always past-tense-free verb
  category    String // Content | SEO | Settings | Users | Roles | Publishing | Approval | Media | Redirects | Integrations
  entityType  String // "Post", "Page", "User", "Redirect", "SiteSetting", ...
  entityId    String?
  entityLabel String? // human-readable label (title/name/email) snapshotted at write time, for a readable log without extra joins
  before      String?  @db.Text // JSON snapshot, null on create
  after       String?  @db.Text // JSON snapshot, null on delete
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model CaseStudy {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  clientName       String
  industry         String
  serviceType      String
  results          String?  @db.Text
  content          String   @db.Text
  excerpt          String?  @db.Text
  websiteUrl       String?
  featuredImage    String?
  featuredImageAlt String?
  imageGallery     String[] // Array of image URLs
  isFeatured       Boolean  @default(false) // Show on home page

  // Relations
  authorId   String?
  author     User?      @relation(fields: [authorId], references: [id])
  categories Category[]
  tags       Tag[]

  // Approval assignment — see the matching comment on Page for why these
  // are plain id pointers rather than Prisma relations.
  reviewerId     String?
  seoReviewerId  String?
  approverId     String?
  reviewDeadline DateTime?

  // SEO Fields
  metaTitle        String?
  metaDescription  String?
  focusKeyword     String?
  ogImage          String?
  twitterCard      String?
  canonicalUrl     String?
  schemaJson       String? @db.Text
  seoScore         Int?
  readabilityScore Int?
  keywordDensity   Float?
  isIndexable      Boolean @default(true)

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage/featuredImage, then SiteSetting.defaultOgImage.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  // Settings
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ------------------------------------------------------
// Lead Capture
// ------------------------------------------------------

model FormSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String   @db.Text
  source    String? // The page where the form was submitted
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

// ------------------------------------------------------
// Technical SEO
// ------------------------------------------------------

model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String? // null only when statusCode is 410 — Gone has nothing to redirect to
  statusCode  Int      @default(301) // 301 | 302 | 307 | 410, enforced at the action layer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotFoundLog {
  id        String   @id @default(cuid())
  path      String
  referer   String?
  userAgent String?
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// Dynamic Page Content Models (Phase 3)
// ------------------------------------------------------

model AgencyService {
  id           String  @id @default(cuid())
  title        String // Card title (homepage) — also the fallback detail page H1
  slug         String? @unique
  subtitle     String?
  description  String  @db.Text // Card description (homepage) — also the fallback detail page intro
  detailTitle  String? // Detail page H1, if different from the card title
  detailIntro  String? @db.Text // Detail page intro paragraph, if different from the card description
  content      String? @db.Text // Optional long-form body for the service detail page
  iconName     String // String name to map to Lucide icon
  features     String? @db.Text // "What's Included" — JSON array of strings (or legacy {icon,text} objects)
  process      String? @db.Text // "Our Process" — JSON array of {step, title, desc}
  deliverables String? @db.Text // "What You Get" — JSON array of strings
  statValue    String?
  statLabel    String?
  gradient     String? // Tailwind class, e.g., "from-blue-500 to-cyan-500"
  order        Int     @default(0) // For sorting on the frontend

  // SEO Fields
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  twitterCard     String?
  isIndexable     Boolean @default(true)

  // Social SEO — per-content OG/Twitter overrides; fall back to metaTitle/
  // metaDescription/ogImage, then SiteSetting.defaultOgImage.
  ogTitle            String?
  ogDescription      String? @db.Text
  twitterTitle       String?
  twitterDescription String? @db.Text
  twitterImage       String?

  faqs      ServiceFaq[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ServiceFaq {
  id        String        @id @default(cuid())
  serviceId String
  service   AgencyService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  answer    String        @db.Text
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([serviceId])
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  role       String?
  company    String?
  industry   String?
  avatar     String? // Image URL or Initials string
  rating     Int      @default(5)
  quote      String   @db.Text
  metrics    String?  @db.Text // JSON array for metrics e.g., [{label: "Revenue Growth", value: "+320%", icon: "TrendingUp"}]
  gradient   String? // Tailwind class, e.g., "from-blue-500 to-cyan-500"
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustedPartner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id             String   @id @default(cuid())
  // Singleton record, can enforce with id = "global"
  phone          String?
  email          String?
  address        String?
  facebookUrl    String?
  twitterUrl     String?
  linkedinUrl    String?
  instagramUrl   String?
  youtubeUrl     String?
  behanceUrl     String?
  dribbbleUrl    String?
  gbpName        String?
  gbpAddress     String?
  gbpPhone       String?
  gbpWebsite     String?
  robotsTxt      String?  @db.Text
  defaultOgImage String? // Site-wide social share image fallback, used when a piece of content has none set
  usdPerGbp      Float?   @default(1.27) // exchange rate for pricing display
  bdtPerGbp      Float?   @default(148.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------
// Phase 3: Keyword & Rank Tracking
// ------------------------------------------------------

model TrackedKeyword {
  id         String      @id @default(cuid())
  term       String
  targetUrl  String? // page path this keyword is meant to rank for, e.g. "/services"
  country    String      @default("GB")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  rankChecks RankCheck[]

  @@unique([term, targetUrl])
}

model RankCheck {
  id               String         @id @default(cuid())
  trackedKeywordId String
  trackedKeyword   TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  position         Int? // null = not found in top results
  checkedAt        DateTime       @default(now())
}

model CompetitorDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  name      String?
  notes     String?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------
// Phase 5: Google Analytics / Search Console Integration
// ------------------------------------------------------

model GoogleIntegration {
  id             String   @id @default(cuid())
  // Singleton record
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  expiresAt      DateTime
  scope          String?
  connectedEmail String?
  ga4PropertyId  String?
  gscSiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ------------------------------------------------------
// Phase 6: Technical/Admin
// ------------------------------------------------------

model WebVitalSample {
  id        String   @id @default(cuid())
  path      String
  metric    String // LCP | CLS | INP | FCP | TTFB
  value     Float
  rating    String // good | needs-improvement | poor
  createdAt DateTime @default(now())

  @@index([metric, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ip        String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  tagline     String?
  priceGbp    Float
  billingTerm String   @default("month") // month | year | one-time
  features    String   @db.Text // JSON array of strings
  isPopular   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ------------------------------------------------------
// Booking / Conversation Scheduling
// ------------------------------------------------------

model AvailableSlot {
  id        String   @id @default(cuid())
  startsAt  DateTime
  duration  Int      @default(30) // minutes
  isBooked  Boolean  @default(false)
  booking   Booking?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
}

model Booking {
  id        String        @id @default(cuid())
  slotId    String        @unique
  slot      AvailableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  company   String?
  message   String?       @db.Text
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model TBJSystem {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  description  String   @db.Text
  iconName     String
  previewIcon  String?
  features     String?  @db.Text // JSON array of features
  status       String?
  progress     Int      @default(0)
  tagline      String?
  gradient     String?
  quarterly    String?
  availability String?
  shapeName    String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per nightly backup attempt, reported by the GitHub Actions
// workflow (.github/workflows/db-backup.yml) that actually performs the
// pg_dump + R2 upload + rotation + restore verification. That work can't
// run inside the Cloudflare Worker itself — Workers can't shell out to
// pg_dump or hold a long-lived raw TCP connection open for it (the exact
// kind of connection that already hung here once, see lib/prisma.ts) — so
// the backup job runs entirely in CI and just reports its result back here,
// the same self-reporting shape as LinkCheckRun below.
model BackupRun {
  id          String   @id @default(cuid())
  startedAt   DateTime
  completedAt DateTime @default(now())
  success     Boolean
  sizeBytes   Int?
  objectKey   String? // R2 object key of the uploaded dump — see docs/runbooks/database-restore.md
  verified    Boolean  @default(false) // restore-into-a-throwaway-Neon-branch round-trip succeeded
  error       String?  @db.Text

  @@index([startedAt])
}

// One row per external uptime probe, reported by the GitHub Actions workflow
// (.github/workflows/uptime-check.yml) that curls the live site from outside
// Cloudflare. A probe running inside the Worker can't detect the Worker
// itself being unreachable, so this intentionally runs from a separate
// vantage point. contentOk is checked in addition to the status code
// because a degraded DB can still serve a 200 with an empty page — exactly
// what happened earlier in production, which an HTTP-status-only check
// would have missed entirely.
model UptimeCheck {
  id         String   @id @default(cuid())
  checkedAt  DateTime @default(now())
  up         Boolean
  statusCode Int?
  contentOk  Boolean  @default(true)
  latencyMs  Int?
  error      String?  @db.Text

  @@index([checkedAt])
}

// Captured server-side runtime errors (via instrumentation.ts's
// onRequestError hook) and client-side top-level render crashes (forwarded
// from app/global-error.tsx) — this project's error-monitoring layer in
// place of a Sentry account/SDK: no new runtime dependency on a Worker
// deployment that has already broken twice on new runtime dependencies this
// week, just a durable log plus a rate-limited email alert, following the
// same self-reporting pattern as LinkCheckRun/BackupRun/UptimeCheck.
// fingerprint (hash of message+path) is used only to de-duplicate repeat
// alerts within a short window — it is not a real grouping engine.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String
  message     String   @db.Text
  stack       String?  @db.Text
  path        String?
  digest      String? // Next.js error digest, for correlating with wrangler tail output
  source      String // "server" | "client"
  createdAt   DateTime @default(now())

  @@index([fingerprint, createdAt])
  @@index([createdAt])
}

// One row per scheduled or manual crawl — the running history is what makes
// this a "monitor" rather than a one-off button, same reasoning as every
// other audit-style table in this schema (AuditLog, ApprovalHistory):
// findings mean nothing if last run overwrites the previous one.
model LinkCheckRun {
  id          String    @id @default(cuid())
  triggeredBy String // "cron" | "manual"
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  internalChecked Int @default(0)
  internalBroken  Int @default(0)
  externalChecked Int @default(0)
  externalBroken  Int @default(0)
  redirectIssues  Int @default(0)

  findings String @db.Text // JSON array of LinkCheckFinding (see lib/link-monitor.ts)

  @@index([startedAt])
}

// One active-editing claim per content item. contentType is a plain string
// ("POST" | "PAGE" | "CASE_STUDY" | "SERVICE" — the ContentKind union in
// lib/dependency-check.ts / lib/content-search.ts), not the Prisma
// ContentType enum used by ApprovalHistory/ContentVersion/ScheduledJob —
// those are specifically about the review/publish workflow Services never
// had, while editing conflicts apply to every rich content form equally.
//
// This is advisory, not authoritative: it's a friendly heads-up ("so-and-so
// has this open"), not what actually prevents an overwrite. The real
// guarantee is the updatedAt check each update action does at save time —
// a lock can go stale if someone's tab just dies without releasing it, but
// a stale updatedAt comparison always catches a genuine conflicting write.
model ContentLock {
  id            String   @id @default(cuid())
  contentType   String
  contentId     String
  lockedById    String
  lockedByName  String?
  lockedByEmail String?
  acquiredAt    DateTime @default(now())
  lastHeartbeat DateTime @default(now())

  @@unique([contentType, contentId])
}
