// ------------------------------------------------------
// Phase 3: Keyword & Rank Tracking
// ------------------------------------------------------

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

enum KeywordStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model TrackedKeyword {
  id           String        @id @default(cuid())
  term         String
  searchIntent SearchIntent  @default(INFORMATIONAL)
  targetUrl    String? // page path this keyword is meant to rank for, e.g. "/services"
  country      String        @default("GB") // ISO 3166-1 alpha-2 — GB | BD | AE are this site's target markets
  language     String        @default("en") // ISO 639-1 — en | bn | ar
  searchVolume Int? // monthly search volume from DataForSEO — null until a metrics refresh succeeds
  difficulty   Int? // 0-100 DataForSEO keyword difficulty score — null until a metrics refresh succeeds
  status       KeywordStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  rankChecks   RankCheck[]

  @@unique([term, targetUrl])
}

model RankCheck {
  id               String         @id @default(cuid())
  trackedKeywordId String
  trackedKeyword   TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  position         Int? // null = not found in top results
  checkedAt        DateTime       @default(now())
}

model CompetitorDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  name      String?
  notes     String?
  createdAt DateTime @default(now())
}

enum RecommendationPriority {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  NEW
  IN_PROGRESS
  DISMISSED
}

// Computed by lib/content-recommendations/ from keyword gaps (GSC queries
// and tracked keywords with no dedicated content) cross-referenced against
// existing Post/CaseStudy titles. Fully re-derivable from live data, so a
// rescan is a safe upsert-by-keyword: NEW rows get their fields refreshed,
// IN_PROGRESS/DISMISSED rows are left alone (see runRecommendationScan's
// own comment) rather than being recreated or reset.
model ContentRecommendation {
  id      String @id @default(cuid())
  keyword String @unique // the GSC query or TrackedKeyword term this gap was found from

  topic           String // suggested working title
  suggestedFormat String // e.g. "How-To Guide", "Listicle", "Comparison", "Explainer", "Case Study", "Standard Post" — a hint for the brief, not an enforced type
  contentType     ContentType // POST | CASE_STUDY — PAGE/SERVICE unused by this feature, same convention as ContentPipelineRun.contentType

  priority      RecommendationPriority
  priorityScore Float // underlying number priority was bucketed from, for stable sort order within a bucket
  reasoning     String                 @db.Text // human-readable explanation of the signals behind the score

  suggestedPublishAt DateTime // spaced out from today using the site's own recent publish cadence + priority rank — see detect.ts
  source             String // "gsc_query" | "tracked_keyword" — which signal this gap came from

  status    RecommendationStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([priority])
}

enum CannibalizationAction {
  MERGE
  DIFFERENTIATE
  REDIRECT
  RETARGET
}

enum CannibalizationStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Computed by lib/content-cannibalization/ — a pair of published Post/
// CaseStudy rows that appear to be competing for the same search intent.
// contentIdA/contentIdB are stored in a canonical sort order (string
// comparison, enforced in code) so a rescan upserts the same row instead
// of creating the mirror image of an existing pair. Entirely advisory —
// this system never merges, redirects, or edits anything itself; every
// suggested action is carried out (or not) by a human elsewhere in the
// admin (the Posts/CaseStudies editors, the Redirects manager), and
// status here only ever changes via that human clicking Resolve/Dismiss.
model ContentCannibalization {
  id String @id @default(cuid())

  contentTypeA ContentType
  contentIdA   String
  contentTypeB ContentType
  contentIdB   String

  similarity    Float // Jaccard word-overlap between the two pages' title+focusKeyword+content; 0 if this pair was only found via the GSC signal below
  sharedQueries String @db.Text // JSON SharedQuery[] (query + each page's impressions); "[]" if this pair was only found via content similarity

  suggestedAction CannibalizationAction
  reasoning       String                @db.Text

  status    CannibalizationStatus @default(OPEN)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([contentIdA, contentIdB])
  @@index([status])
}

enum OrphanPageStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// Computed by lib/orphan-pages/ — a published Post/CaseStudy with zero or
// one inbound internal link from another piece of content's body (0 =
// orphan, 1 = weakly linked — a single source page is fragile, since
// losing it makes the target a true orphan; 2+ is healthy and never
// flagged). Pages and Services are out of scope entirely (see the matching
// comment in lib/orphan-pages/detect.ts). Entirely advisory, same
// convention as ContentCannibalization just above: this system never adds
// a link itself; status only changes via a human clicking Resolve (they
// added a link somewhere) or Dismiss.
model OrphanPage {
  id          String      @id @default(cuid())
  contentType ContentType // POST | CASE_STUDY only
  contentId   String      @unique

  inboundLinkCount Int
  suggestions      String @db.Text // JSON LinkSuggestion[] (source page, anchor, context, similarity) — see lib/orphan-pages/types.ts

  status    OrphanPageStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([status])
}

enum ContentHealthGrade {
  EXCELLENT
  GOOD
  NEEDS_ATTENTION
  POOR
}

// A recomputed snapshot, not a lifecycle like ContentRefresh/
// ContentRecommendation/ContentCannibalization above — there's nothing to
// approve, dismiss, or apply here, just a number and its breakdown, so a
// rescan always overwrites the existing row for that content outright.
// Computed by lib/content-health/score.ts.
model ContentHealthScore {
  id          String      @id @default(cuid())
  contentType ContentType
  contentId   String

  overallScore Float
  grade        ContentHealthGrade

  // JSON FactorScore[] (lib/content-health/types.ts) — each of the 8
  // factors' score (null when that page had no data for it, e.g. no
  // tracked keyword) and a human-readable detail string, computed once
  // here so the admin page can render the full breakdown without
  // recomputing or re-fetching GA4/GSC on every page view.
  factors String @db.Text

  computedAt DateTime @default(now())

  @@unique([contentType, contentId])
  @@index([grade])
}

// ------------------------------------------------------
// Phase 5: Google Analytics / Search Console Integration
// ------------------------------------------------------

model GoogleIntegration {
  id             String   @id @default(cuid())
  // Singleton record
  accessToken    String   @db.Text
  refreshToken   String   @db.Text
  expiresAt      DateTime
  scope          String?
  connectedEmail String?
  ga4PropertyId  String?
  gscSiteUrl     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One row per (date, query, page, country, device) combination pulled from
// Search Console's searchAnalytics.query endpoint — persisted (rather than
// fetched live like fetchGSCClicks/fetchTopSearchQueries above) so an
// admin can view history across date ranges without re-hitting the GSC API
// every time, and so each row can carry its resolved CMS content mapping.
// contentType is a plain string (not the ContentType enum) because it must
// also cover "SERVICE", same reasoning as ContentLock.contentType — both
// are null when `page` didn't match any known Post/Page/CaseStudy/Service
// slug (deleted content, an asset URL, the homepage, a listing page like
// /blog) rather than guessed at.
model SearchConsoleMetric {
  id      String   @id @default(cuid())
  date    DateTime
  query   String
  page    String
  country String // GSC's own 3-letter ISO code, e.g. "gbr"
  device  String // "DESKTOP" | "MOBILE" | "TABLET", as GSC returns it

  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  contentType String?
  contentId   String?

  importedAt DateTime @default(now())

  @@unique([date, query, page, country, device])
  @@index([date])
  @@index([contentType, contentId])
  @@index([query])
}

// One row per (date, landing page) combination pulled from the GA4 Data
// API, filtered to the Organic Search channel only — this is specifically
// the SEO -> Traffic -> Conversion dataset, not general site analytics
// (fetchGA4Traffic above is the unfiltered, non-persisted site-wide one).
// engagementRate and conversionRate are deliberately NOT stored columns:
// averaging per-row rates across multiple days would be wrong once sessions
// vary row to row, so both are always derived at query time from the summed
// counts (engagedSessions/sessions, conversions/sessions). contentType is a
// plain string for the same reason as SearchConsoleMetric.contentType above
// — it must also cover "SERVICE" — and both are null when `landingPage`
// didn't match a known slug.
model AnalyticsLandingPageMetric {
  id          String   @id @default(cuid())
  date        DateTime
  landingPage String

  sessions        Int // organic sessions only
  engagedSessions Int
  conversions     Int

  contentType String?
  contentId   String?

  importedAt DateTime @default(now())

  @@unique([date, landingPage])
  @@index([date])
  @@index([contentType, contentId])
}

