{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tbj",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "keep_vars": true,

  // --- ISR cache (see open-next.config.ts and docs/deployment.md) ---
  // The Worker calls itself to re-render a page in the background.
  // "service" must match "name" above.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "tbj" }],
  // Rendered pages. Create this bucket before deploying.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "tbj-next-cache" }],
  // Revalidation timestamps written by revalidatePath(). Create this database
  // before deploying and paste its ID here. The deploy command creates the table.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "tbj-next-tag-cache",
      "database_id": "832db460-09ac-40c4-9517-ce04bc8770f0"
    }
  ],
  // Background revalidation queue. Created automatically by the deploy.
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],

  // --- Rate limits for the public reporting endpoints (lib/rate-limit.ts) ---
  // Counted separately in each Cloudflare location, and approximate. Nothing
  // to create in the dashboard: the deploy sets these up. namespace_id is any
  // positive integer that no other rate limiter in the account uses.
  "ratelimits": [
    // app/api/internal/client-error: one report per client crash. A visitor
    // hitting a crash loop is capped at 5 a minute.
    { "name": "CLIENT_ERROR_IP_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "CLIENT_ERROR_GLOBAL_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    // app/api/web-vitals:
    // A real visitor sends at most one report per page load, so 10 a minute
    // per IP is generous.
    { "name": "WEB_VITALS_IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Ceiling for all visitors together, so a flood from many IPs still
    // can't write unlimited rows to Neon.
    { "name": "WEB_VITALS_GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ]
}
