# Copy to .env for local `next dev`. Never put real values in wrangler.jsonc —
# see docs/runbooks/security.md for why, and where each of these actually
# lives for the deployed Worker (Cloudflare dashboard → Workers & Pages →
# the Worker → Settings → Variables and Secrets, not this repo).

DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
