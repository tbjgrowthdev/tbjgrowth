# Copy to .env for local `next dev`. Never put real values in wrangler.jsonc —
# see docs/runbooks/security.md for why, and where each of these actually
# lives for the deployed Worker (Cloudflare dashboard → Workers & Pages →
# the Worker → Settings → Variables and Secrets, not this repo).

DATABASE_URL=
# DIRECT_URL is Neon's unpooled (direct) connection string, used only by the
# Prisma CLI for migrations (prisma.config.ts). Migrations need a direct
# connection because the pooled DATABASE_URL (PgBouncer) can't run them.
# The running app never reads it. Careful: if it points at production, every
# `prisma migrate` command runs against production (docs/deployment.md).
DIRECT_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Integration Hub (app/(admin)/admin/integrations) — encrypts credentials
# for providers it owns (Google Business Profile, Meta, CRM, Slack,
# WordPress, Webhooks). Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# AI Content Pipeline (app/(admin)/admin/ai-pipeline)
# AI_PROVIDER is the server default — anthropic | openai | gemini | xai |
# openrouter | cerebras. A Super Admin can switch provider/model from
# Settings → AI Provider without changing these, and can enter API keys there
# (stored encrypted; an admin-entered key overrides the env var below).
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

XAI_API_KEY=
XAI_MODEL=grok-4.3

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Image generation for the pipeline's Image stage — separate selection from
# AI_PROVIDER above since Anthropic has no image-generation API. Uses
# whichever of OPENAI_API_KEY / GEMINI_API_KEY above is already set.
AI_IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
