<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup or device-to-device transfer of app data: the WebView
     cookie store holds the admin session (a restored copy on another phone
     would be signed in without 2FA). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
